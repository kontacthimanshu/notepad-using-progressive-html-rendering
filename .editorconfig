root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h}]
indent_style = space
indent_size = 4

[*.{css,md,cmake,txt,json,pxs}]
end_of_line = lf
indent_style = space
indent_size = 2

[CMakeLists.txt]
end_of_line = lf
indent_style = space
indent_size = 4
