{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "host=x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "CMAKE_SYSTEM_VERSION": "10.0.26100.0" }
    },
    { "name": "x64-debug", "displayName": "x64 Debug (VS 2026)", "inherits": "base" },
    { "name": "x64-release", "displayName": "x64 Release (VS 2026)", "inherits": "base" },
    {
      "name": "vs2022-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022"
    },
    { "name": "vs2022-x64-debug", "displayName": "x64 Debug (VS 2022)", "inherits": "vs2022-base" },
    { "name": "vs2022-x64-release", "displayName": "x64 Release (VS 2022)", "inherits": "vs2022-base" }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "x64-release", "configuration": "Release" },
    { "name": "vs2022-x64-debug", "configurePreset": "vs2022-x64-debug", "configuration": "Debug" },
    { "name": "vs2022-x64-release", "configurePreset": "vs2022-x64-release", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 300 },
      "filter": { "exclude": { "label": "perf|package" } }
    },
    { "name": "x64-debug", "inherits": "test-base", "configurePreset": "x64-debug", "configuration": "Debug" },
    { "name": "x64-release", "inherits": "test-base", "configurePreset": "x64-release", "configuration": "Release" },
    {
      "name": "x64-release-perf",
      "configurePreset": "x64-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "perf" } }
    },
    {
      "name": "x64-release-package",
      "configurePreset": "x64-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "package" } }
    }
  ],
  "packagePresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "generators": [ "ZIP" ],
      "configurations": [ "Release" ]
    }
  ]
}
